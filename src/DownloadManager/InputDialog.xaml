<Window x:Class="DownloadManager.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrganizeMyDownloads"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="White"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="24,24,24,24">
            <TextBlock x:Name="PromptText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <TextBox x:Name="InputBox"
                     Height="26"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#F0F0F0"
                Padding="24,14,24,14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="OK"
                        Width="80"
                        Height="26"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="OnOk"/>

                <Button Content="Cancel"
                        Width="80"
                        Height="26"
                        IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
